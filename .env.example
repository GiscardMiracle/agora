# First admin account, created at startup only while no account exists.
# Accounts then live in the database; changing these has no effect on an existing account.
AGORA_ADMIN_USER=admin
AGORA_PASSWORD=change-me
# Recommended: random string for session cookies (openssl rand -hex 32). Auto-generated in data/.secret if empty.
AGORA_SECRET=
# GitHub token (fine-grained, read-only "Contents"/"Metadata" on the org): lists repositories and commit authors.
# Cloning itself uses each user's own SSH key (generated in "my account").
AGORA_GITHUB_TOKEN=
# Commit emails ending with this name the groups (e.g. @my-school.eu). Empty = any non-noreply email.
AGORA_EMAIL_DOMAIN=
# Set to 1 when served over HTTPS (secure cookie).
AGORA_HTTPS=0
# Time zone of scheduled runs (e.g. Europe/Paris). Empty = the server's own time zone.
AGORA_TZ=
# Builds in parallel. 2 is safe on a 2 GB VPS that also runs other things.
AGORA_WORKERS=2
AGORA_DATA_DIR=./data
AGORA_DEFAULT_IMAGE=agora-runner:latest
# Builds kept per repository (older ones and their logs are deleted).
AGORA_KEEP_BUILDS=20
# Finished builds and logs older than this many days are deleted automatically (0 = never).
AGORA_RETENTION_DAYS=90
