# Required: password for the web UI.
AGORA_PASSWORD=change-me
# Recommended: random string for session cookies (openssl rand -hex 32). Auto-generated in data/.secret if empty.
AGORA_SECRET=
# GitHub token (fine-grained, read-only "Contents" on the org) to clone private repos over https.
# Alternative: leave empty and use git@github.com:... URLs with an SSH key of the agora user.
AGORA_GITHUB_TOKEN=
# Set to 1 when served over HTTPS (secure cookie).
AGORA_HTTPS=0
# Builds in parallel. 2 is safe on a 2 GB VPS that also runs other things.
AGORA_WORKERS=2
AGORA_DATA_DIR=./data
AGORA_DEFAULT_IMAGE=agora-runner:latest
# Builds kept per repository (older ones and their logs are deleted).
AGORA_KEEP_BUILDS=20
